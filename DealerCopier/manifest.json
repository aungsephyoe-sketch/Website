{
  "manifest_version": 3,
  "name": "Dealer to Marketplace",
  "version": "3.1",
  "description": "Extract car listings and auto-fill Facebook Marketplace.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://www.facebook.com/marketplace/create/vehicle*"], "js": ["fb-autofill.js"], "run_at": "document_idle" }
  ]
}
