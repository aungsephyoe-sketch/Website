# ── Admin panel ──────────────────────────────────────────────────────────
# Password for logging in at /admin. Pick something long and unique.
ADMIN_PASSWORD=change-me-please

# Random string used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# ── Twilio (text-message alerts for every new inquiry) ─────────────────────
# 1. Create an account at https://www.twilio.com/try-twilio
# 2. Buy/activate a phone number that can send SMS: https://console.twilio.com/us1/develop/phone-numbers/manage/incoming
# 3. Find your Account SID + Auth Token on the Console dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number you purchased, in E.164 format (e.g. +15551234567)
TWILIO_FROM_NUMBER=
# The phone that should RECEIVE the text alert for every inquiry, E.164 format.
# Defaults to the Shopusedcarz contact number — change if texts should go elsewhere.
OWNER_PHONE_NUMBER=+14698813778
