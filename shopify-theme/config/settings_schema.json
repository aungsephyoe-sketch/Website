    {
        "name": "Logo",
        "settings": [
            {
                "type": "image_picker",
                "id": "logo",
                "label": "Logo image",
                "info": "Optional. Leave blank to use the wordmark \"Ares Pantheon\" as text."
            },
            {
                "type": "image_picker",
                "id": "favicon",
                "label": "Favicon",
                "info": "Displayed as the browser tab icon. Will be scaled to 32 x 32px."
            }
        ]
    },
    {
        "name": "Colors",
        "settings": [
            { "type": "color", "id": "color_black", "label": "Black", "default": "#000000" },
            { "type": "color", "id": "color_white", "label": "White", "default": "#ffffff" },
            { "type": "color", "id": "color_off_white", "label": "Off white", "default": "#f5f0eb" },
            { "type": "color", "id": "color_cream", "label": "Cream", "default": "#ede6db" },
            { "type": "color", "id": "color_gray", "label": "Gray (secondary text)", "default": "#8a8a8a" },
            { "type": "color", "id": "color_brown", "label": "Brown (accent)", "default": "#6b5b45" },
            { "type": "color", "id": "color_gold", "label": "Gold (accent)", "default": "#c4a265" }
        ]
    },
    {
        "name": "Cart & shipping",
        "settings": [
            {
                "type": "text",
                "id": "shipping_note",
                "label": "Shipping note",
