<div class="container">
  <div class="page-header">
    <h1>{{ blog.title }}</h1>
  </div>
  <div class="journal-list">
    {%- paginate blog.articles by 12 -%}
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="journal-item">
          {%- if article.image -%}
            <div class="journal-item-img">
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy">
            </div>
          {%- endif -%}
          <div class="journal-item-info">
            <span class="duo-category">{{ article.published_at | date: '%B %d, %Y' }}</span>
            <h3 class="duo-title">{{ article.title }}</h3>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </div>
        </a>
      {%- else -%}
        <p style="color:var(--gray)">No posts yet.</p>
      {%- endfor -%}
      {%- if paginate.pages > 1 -%}
        <div class="collection-pagination">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog page"
}
{% endschema %}
