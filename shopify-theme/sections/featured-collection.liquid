<section class="section" id="collection">
    <div class="container">
        <div class="collection-header" data-animate>
            <h2 class="collection-title">{{ section.settings.heading }}</h2>
            {% if section.blocks.size > 0 %}
                <div class="collection-filters" data-product-filters>
                    {% for block in section.blocks %}
                        <button type="button" class="filter-btn{% if forloop.first %} active{% endif %}" data-filter-tag="{{ block.settings.tag }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {% if section.settings.collection != blank %}
            {% assign products_source = section.settings.collection.products %}
        {% else %}
            {% assign products_source = collections.all.products %}
        {% endif %}

        <div class="product-grid" data-animate data-product-grid>
            {% for product in products_source limit: section.settings.products_to_show %}
                {% render 'product-card', product: product %}
            {% else %}
                <p>No products yet — add products to a collection and select it in the theme editor.</p>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Featured collection",
    "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The Collection" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave blank to show all products." },
        { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 8 }
    ],
    "blocks": [
        {
            "type": "filter",
            "name": "Filter button",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "All" },
                { "type": "text", "id": "tag", "label": "Product tag to match", "info": "Leave blank on the \"All\" button." }
            ]
        }
    ],
    "max_blocks": 6,
    "default": {
        "blocks": [
            { "type": "filter", "settings": { "label": "All", "tag": "" } },
            { "type": "filter", "settings": { "label": "Compression", "tag": "Compression" } },
            { "type": "filter", "settings": { "label": "Oversized", "tag": "Oversized" } },
            { "type": "filter", "settings": { "label": "Long Sleeve", "tag": "Long Sleeve" } }
        ]
    },
    "presets": [
        { "name": "Featured collection" }
    ]
}
{% endschema %}
