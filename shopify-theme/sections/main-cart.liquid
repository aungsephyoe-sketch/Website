<div class="container">
    <div class="page-header">
        <h1>Your Cart</h1>
    </div>

    <div class="cart-layout" id="cartLayout">
        {% if cart.item_count == 0 %}
            <div class="cart-empty">
                <p>Your cart is empty.</p>
                <a href="{{ routes.root_url }}">Continue Shopping</a>
            </div>
        {% else %}
            <form action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
                <div class="cart-items" id="cartItems">
                    {% for item in cart.items %}
                        <div class="cart-item" data-cart-item data-line-key="{{ item.key }}" data-line-index="{{ forloop.index }}">
                            <div class="cart-item-img">
                                <a href="{{ item.url }}">
                                    {% if item.image %}
                                        <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="{{ item.image.width }}" height="{{ item.image.height }}" loading="lazy">
                                    {% endif %}
                                </a>
                            </div>
                            <div class="cart-item-info">
                                <div class="cart-item-name"><a href="{{ item.url }}">{{ item.product.title }}</a></div>
                                {% unless item.variant.title == 'Default Title' %}
                                    <div class="cart-item-meta">{{ item.variant.title }}</div>
                                {% endunless %}
                                <div class="cart-item-qty">
                                    <button type="button" class="qty-btn" data-qty-decrease aria-label="Decrease quantity">&minus;</button>
                                    <span class="qty-num" data-qty-value>{{ item.quantity }}</span>
                                    <button type="button" class="qty-btn" data-qty-increase aria-label="Increase quantity">+</button>
                                </div>
                                <button type="button" class="cart-item-remove" data-cart-remove>Remove</button>
                            </div>
                            <div class="cart-item-price" data-line-price>{{ item.final_line_price | money }}</div>
                        </div>
                    {% endfor %}
                </div>
                <div class="cart-summary">
                    <h2>Order Summary</h2>
                    <div class="summary-row"><span>Subtotal</span><span data-cart-subtotal>{{ cart.total_price | money }}</span></div>
                    <div class="summary-row"><span>Shipping</span><span>Calculated at checkout</span></div>
                    <div class="summary-row total"><span>Total</span><span data-cart-total>{{ cart.total_price | money }}</span></div>
                    <button type="submit" name="checkout" class="checkout-btn">Proceed to Checkout</button>
                    <a href="{{ routes.root_url }}" class="continue-link">Continue Shopping</a>
                    <p class="summary-shipping">{{ settings.shipping_note | default: 'Complimentary shipping on all orders' }}</p>
                </div>
            </form>
        {% endif %}
    </div>
</div>

{% schema %}
{
    "name": "Cart page",
    "settings": []
}
{% endschema %}
