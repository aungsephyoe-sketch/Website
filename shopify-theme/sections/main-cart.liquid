<div class="container">
  <div class="page-header">
    <h1>Your Cart</h1>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="cart-layout">
      <div class="cart-empty">
        <p>Your cart is empty.</p>
        <a href="{{ routes.root_url }}">Continue Shopping</a>
      </div>
    </div>
  {%- else -%}
    {%- form 'cart', cart, id: 'CartForm' -%}
      <div class="cart-layout">
        <div class="cart-items" id="cartItems">
          {%- for item in cart.items -%}
            <div class="cart-item" data-line="{{ forloop.index }}">
              <div class="cart-item-img">
                <a href="{{ item.url }}">
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy">
                </a>
              </div>
              <div class="cart-item-info">
                <a href="{{ item.url }}" class="cart-item-name">{{ item.product.title }}</a>
                <div class="cart-item-meta">
                  {%- if item.variant.title != 'Default Title' -%}{{ item.variant.title }}{%- endif -%}
                </div>
                <div class="cart-item-qty">
                  <button type="submit" name="updates[{{ forloop.index }}]" value="{{ item.quantity | minus: 1 }}" class="qty-btn" data-qty-change data-line="{{ forloop.index }}" aria-label="Decrease quantity">&minus;</button>
                  <span class="qty-num" data-qty-display="{{ forloop.index }}">{{ item.quantity }}</span>
                  <button type="submit" name="updates[{{ forloop.index }}]" value="{{ item.quantity | plus: 1 }}" class="qty-btn" data-qty-change data-line="{{ forloop.index }}" aria-label="Increase quantity">+</button>
                </div>
                <button type="submit" name="updates[{{ forloop.index }}]" value="0" class="cart-item-remove" data-line="{{ forloop.index }}">Remove</button>
              </div>
              <div class="cart-item-price" data-line-price="{{ forloop.index }}">{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-summary">
          <h2>Order Summary</h2>
          <div class="summary-row"><span>Subtotal</span><span id="CartSubtotal">{{ cart.total_price | money }}</span></div>
          <div class="summary-row"><span>Shipping</span><span>Free</span></div>
          <div class="summary-row total"><span>Total</span><span id="CartTotal">{{ cart.total_price | money }}</span></div>
          <button type="submit" name="checkout" class="checkout-btn">Proceed to Checkout</button>
          <a href="{{ routes.root_url }}" class="continue-link">Continue Shopping</a>
          <p class="summary-shipping">Complimentary shipping on all orders</p>
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page"
}
{% endschema %}
