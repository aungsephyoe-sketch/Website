<section class="hero" id="hero">
    <div class="hero-image">
        {% if section.settings.image %}
            <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        {% else %}
            <img src="{{ 'hero-beach-squad.jpeg' | asset_url }}" alt="{{ section.settings.heading | strip_html }}">
        {% endif %}
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="hero-eyebrow">{{ section.settings.eyebrow }}</span>
        <h1 class="hero-title">{{ section.settings.heading }}</h1>
        {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link | default: '#collection' }}" class="hero-cta">{{ section.settings.button_label }}</a>
        {% endif %}
    </div>
</section>

{% schema %}
{
    "name": "Hero banner",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "eyebrow",
            "label": "Eyebrow",
            "default": "Summer 2026"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "info": "Simple HTML like <br> is allowed.",
            "default": "The Pantheon<br>Collection"
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "Button label",
            "default": "Discover"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
        }
    ],
    "presets": [
        {
            "name": "Hero banner"
        }
    ]
}
{% endschema %}
