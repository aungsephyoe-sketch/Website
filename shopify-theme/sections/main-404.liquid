<div class="container">
    <div class="page-header">
        <h1>Page Not Found</h1>
    </div>
    <div class="page-content" style="padding:40px 0 100px;text-align:center;">
        <p style="color:var(--gray);margin-bottom:32px;">The page you're looking for doesn't exist or has been moved.</p>
        <a href="{{ routes.root_url }}" class="btn-dark">Return Home</a>
    </div>
</div>

{% schema %}
{
    "name": "404 page",
    "settings": []
}
{% endschema %}
