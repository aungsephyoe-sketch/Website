<section class="editorial-section" id="editorial" data-animate>
    <div class="editorial-layout">
        <div class="editorial-image">
            {% if section.settings.image %}
                <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
            {% else %}
                <img src="{{ 'product-ares-womens-tee.jpeg' | asset_url }}" alt="{{ section.settings.heading | strip_html }}" loading="lazy">
            {% endif %}
        </div>
        <div class="editorial-content">
            <span class="editorial-eyebrow">{{ section.settings.eyebrow }}</span>
            <h2 class="editorial-title">{{ section.settings.heading }}</h2>
            {% if section.settings.text != blank %}
                <p>{{ section.settings.text }}</p>
            {% endif %}
            {% if section.settings.link_text != blank %}
                <a href="{{ section.settings.link_url | default: '#' }}" class="editorial-link">{{ section.settings.link_text }}</a>
            {% endif %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Editorial image + text",
    "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Community" },
        { "type": "text", "id": "heading", "label": "Heading", "info": "Simple HTML like <br> and <em> is allowed.", "default": "Built for<br>the <em>Few</em>" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Ares Pantheon is not mass-produced. Every piece is a statement — a commitment to the relentless pursuit of the best version of yourself. Worn by athletes, creators, and warriors who refuse to settle." },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Discover Our Story" },
        { "type": "url", "id": "link_url", "label": "Link" }
    ],
    "presets": [
        { "name": "Editorial image + text" }
    ]
}
{% endschema %}
