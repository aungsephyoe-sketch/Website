<section class="world-section" id="world">
    <div class="world-banner" data-animate>
        <div class="world-image">
            {% if section.settings.image %}
                <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
            {% else %}
                <img src="{{ 'hero-motorcycle.jpeg' | asset_url }}" alt="{{ section.settings.heading | strip_html }}" loading="lazy">
            {% endif %}
        </div>
        <div class="world-overlay"></div>
        <div class="world-content">
            <span class="world-eyebrow">{{ section.settings.eyebrow }}</span>
            <h2 class="world-title">{{ section.settings.heading }}</h2>
            {% if section.settings.button_label != blank %}
                <a href="{{ section.settings.button_link | default: '#' }}" class="world-cta">{{ section.settings.button_label }}</a>
            {% endif %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "World banner",
    "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Enter" },
        { "type": "text", "id": "heading", "label": "Heading", "info": "Simple HTML like <br> is allowed.", "default": "The World<br>of Ares" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
        { "type": "url", "id": "button_link", "label": "Button link" }
    ],
    "presets": [
        { "name": "World banner" }
    ]
}
{% endschema %}
