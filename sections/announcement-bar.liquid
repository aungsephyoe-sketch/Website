{%- if section.settings.text != blank -%}
<div class="announcement-bar">
  <p>
    {{ section.settings.text }}
    {%- if section.settings.link != blank and section.settings.link_text != blank -%}
      &nbsp;&mdash; <a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>
    {%- endif -%}
  </p>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "default": "Complimentary Shipping on All Orders"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop Now"
    }
  ]
}
{% endschema %}
